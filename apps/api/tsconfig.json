{
  "extends": "@repo/typescript-config/node.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "noEmit": false,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": false,
    "resolveJsonModule": true
  },
  "tsc-alias": {
    "resolveExtensions": {
      "utils": ["js"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "src/__tests__/**/*", "**/*.test.ts"]
}
