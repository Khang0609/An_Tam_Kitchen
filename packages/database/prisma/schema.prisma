// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

datasource db {
  provider = "postgresql"
}
generator client {
  provider = "prisma-client-js"
}

model User {
  id             String          @id @default(uuid(7))
  email          String          @unique
  name           String?
  password       String
  isGuest        Boolean         @default(false)
  refreshToken   String?
  resetToken     String?   @unique
  resetTokenExpiry DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  posts          Post[]
  inventoryItems InventoryItem[]
  userProducts   UserProduct[]
}

model Post {
  id        String  @id @default(uuid(7))
  title     String
  content   String?
  published Boolean @default(false)
  author    User    @relation(fields: [authorId], references: [id])
  authorId  String
}

enum StorageLocation {
  fridge
  freezer
  room_temp
}

enum FoodStatus {
  fresh
  use_soon
  check_before_use
  not_recommended
}

enum NotificationType {
  expiry_warning
  open_limit_warning
}

model Country {
  id          String    @id @default(uuid(7))
  name        String
  countryCode String
  companies   Company[]
}

model Company {
  id        String    @id @default(uuid(7))
  countryId String
  country   Country   @relation(fields: [countryId], references: [id])
  name      String
  products  Product[]
}

model Category {
  id                 String    @id @default(uuid(7))
  name               String
  defaultSpoiledSign String?
  products           Product[]
}

model Product {
  id                    String   @id @default(uuid(7))
  categoryId            String
  category              Category @relation(fields: [categoryId], references: [id])
  companyId             String
  company               Company  @relation(fields: [companyId], references: [id])
  name                  String
  barcode               String
  shelfLifeUnopenedDays Int
  shelfLifeOpenedDays   Int
  freshDays             Int
  earlyConsumptionDays  Int
  checkBeforeUseDays    Int
  spoiledSign           String?
}

model InventoryItem {
  id            String             @id @default(uuid(7))
  userId        String
  user          User               @relation(fields: [userId], references: [id])
  userProductId String
  userProduct   UserProduct        @relation(fields: [userProductId], references: [id])
  displayName   String
  openedAt      DateTime?
  expiryDate    DateTime
  location      StorageLocation    @default(fridge)
  status        FoodStatus         @default(fresh)
  notes         String?
  quantity      String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  notifications FoodNotification[]
}

model FoodNotification {
  id              String           @id @default(uuid(7))
  inventoryItemId String
  inventoryItem   InventoryItem    @relation(fields: [inventoryItemId], references: [id])
  type            NotificationType
  message         String
  isRead          Boolean          @default(false)
  createdAt       DateTime         @default(now())
}

model UserProduct {
  id              String          @id @default(uuid(7))
  userId          String
  user            User            @relation(fields: [userId], references: [id])
  name            String
  company         String          @default("Unknown")
  barcode         String?
  category        String
  imageUrl        String?
  storageLocation String          @map("storage_location")
  daysBeforeOpen  Int             @default(30)
  daysAfterOpen   Int             @default(7)
  note            String?
  inventoryItems  InventoryItem[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}
