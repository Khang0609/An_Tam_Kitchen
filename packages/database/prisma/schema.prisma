// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

datasource db {
  provider = "postgresql"
}
generator client {
  provider = "prisma-client-js"
}

model User {
  id             String          @id @default(uuid(7))
  email          String          @unique
  name           String?
  password       String
  isGuest        Boolean         @default(false)
  refreshToken   String?
  resetToken     String?   @unique
  resetTokenExpiry DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  posts          Post[]
  inventoryItems InventoryItem[]
}

model Post {
  id        String  @id @default(uuid(7))
  title     String
  content   String?
  published Boolean @default(false)
  author    User    @relation(fields: [authorId], references: [id])
  authorId  String
}

enum StorageLocation {
  fridge
  freezer
  room_temp
}

enum FoodStatus {
  fresh
  use_soon
  check_before_use
  not_recommended
}

enum NotificationType {
  expiry_warning
  open_limit_warning
}

model Country {
  id          String    @id @default(uuid(7))
  name        String
  countryCode String
  companies   Company[]
}

model Company {
  id        String    @id @default(uuid(7))
  countryId String
  country   Country   @relation(fields: [countryId], references: [id])
  name      String
  products  Product[]
}

model Category {
  id                 String    @id @default(uuid(7))
  name               String
  defaultSpoiledSign String?
  products           Product[]
}

model Product {
  id                    String          @id @default(uuid(7))
  categoryId            String?
  category              Category?       @relation(fields: [categoryId], references: [id])
  companyId             String?
  company               Company?        @relation(fields: [companyId], references: [id])
  name                  String
  barcode               String?
  shelfLifeUnopenedDays Int             @default(30)
  shelfLifeOpenedDays   Int             @default(7)
  freshDays             Int             @default(3)
  earlyConsumptionDays  Int             @default(2)
  checkBeforeUseDays    Int             @default(1)
  spoiledSign           String?
  imageUrl              String?
  storageLocation       StorageLocation @default(fridge)
  isQualified           Boolean         @default(false)
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  inventoryItems        InventoryItem[]
}

model InventoryItem {
  id            String             @id @default(uuid(7))
  userId        String
  user          User               @relation(fields: [userId], references: [id])
  productId     String
  product       Product            @relation(fields: [productId], references: [id])
  displayName   String
  openedAt      DateTime?
  expiryDate    DateTime
  location      StorageLocation    @default(fridge)
  status        FoodStatus         @default(fresh)
  notes         String?
  quantity      String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  notifications FoodNotification[]
}

model FoodNotification {
  id              String           @id @default(uuid(7))
  inventoryItemId String
  inventoryItem   InventoryItem    @relation(fields: [inventoryItemId], references: [id])
  type            NotificationType
  message         String
  isRead          Boolean          @default(false)
  createdAt       DateTime         @default(now())
}
